-At a vertex $k$, associate to an incident edge the signed vectors
-\[
-    v_{k,ik}:=K_{ik}\overline e_i\quad(i<k),
-    \qquad
-    v_{k,kj}:=-K_{kj}\overline e_j\quad(k<j).
-\]
-
-\begin{proposition}[Complete-graph defect certificate]
-\label[proposition]{prop:sos-complete-graph}
-With the skew Kraus normalization used in
-\cref{eq:Kc-norm},
-\begin{equation}
-\label{eq:sos-complete-graph}
-\boxed{
-\begin{aligned}
- &(r-1)\norm c^2-\norm{\mathcal T_-c}^2\\
- &\quad=
- \frac{r-1}{2}\sum_{i<j}
- \left[
-   \frac12\norm{K_{ij}}_2^2
-   -\norm{K_{ij}\overline e_i}^2
-   -\norm{K_{ij}\overline e_j}^2
- \right]\\
- &\qquad+
- \frac12\sum_{k=1}^r
- \sum_{\substack{e<f\\e,f\ni k}}
- \norm{v_{k,e}-v_{k,f}}^2.
-\end{aligned}}
-\end{equation}
-Every term on the right is nonnegative.  Consequently
-\[
-    \norm{\mathcal T_-}^2\le r-1,
-\]
-and, since its range is orthogonal to $\psi$,
-$B_E\succeq0$.
-\end{proposition}
-
-\begin{proof}
-At every vertex use the exact variance identity
-\[
-    (r-1)\sum_{e\ni k}\norm{v_{k,e}}^2
-    -\norm{\sum_{e\ni k}v_{k,e}}^2
-    =
-    \sum_{\substack{e<f\\e,f\ni k}}
-    \norm{v_{k,e}-v_{k,f}}^2.
-\]
-Sum over vertices and use
-\cref{eq:T-by-vertices}.  Each edge contributes its two endpoint
-actions, while
-$\norm{K_{ij}}_2^2=4\norm{c^{(ij)}}^2$ by
-\cref{eq:Kc-norm}.  Adding and subtracting the total edge action gives
-exactly \cref{eq:sos-complete-graph}.  The edge brackets are
-nonnegative by \cref{lem:double-skew}.  The final operator conclusion
-then follows exactly as in the last paragraph of the proof of
-\cref{prop:operator_ineq}.
-\end{proof}
-
-The edge brackets themselves admit a complete spectral
-sum-of-squared-norms expansion rather than merely a nonnegativity
-argument.
-
-\begin{lemma}[Extended SOS for a double-skew edge]
-\label[lemma]{lem:sos-double-skew-edge}
-Let
-$K\in\mathfrak{so}(U)\otimes\mathfrak{so}(V)$ be nonzero, and let
-$P_0$ be any rank-two projection.  Write
-\[
-    K^*K=\sum_{\ell}\lambda_\ell\ketbra{u_\ell}{u_\ell},
-    \qquad
-    \lambda_1\ge\lambda_2\ge\cdots\ge0.
-\]
-Choose top Takagi vectors
-$x=\operatorname{vec}(X)$ and $y=\operatorname{vec}(Y)$ of the
-complex symmetric operator $K$, and set
-\[
-    \sigma=(\lambda_1+\lambda_2)^{1/2},
-    \qquad
-    a=\frac{\sqrt{\lambda_1}}{\sigma},
-    \qquad
-    b=\frac{\sqrt{\lambda_2}}{\sigma}.
-\]
-Under the output--input regrouping from
-\cref{lem:double-skew}, let $P_{--}$ be the double-antisymmetric
-projection and $J$ the regrouping unitary.  Put
-\[
-    z=a\,x\otimes x+b\,y\otimes y,
-    \qquad
-    p=\norm{P_{--}Jz}^2>0,
-    \qquad
-    \widehat K=\frac{P_{--}Jz}{\sqrt p}.
-\]
-Then
-\begin{equation}
-\label{eq:sos-double-skew-edge}
-\begin{aligned}
- &\frac12\norm K_2^2-\Tr(P_0K^*K)\\
- &={}
- \frac{\norm K_2^2}{2}
- \norm{aXX^*-bYY^*}_2^2\\
- &\quad+
- \frac{ab\norm K_2^2}{2}
- \norm{X^*Y+Y^*X}_2^2\\
- &\quad+
- p\norm{
-   (I-\ketbra{\widehat K}{\widehat K})K
- }_2^2\\
- &\quad+
- (\lambda_1-\lambda_2)
- \norm{(I-P_0)u_1}^2\\
- &\quad+
- \sum_{\ell\ge3}
- (\lambda_2-\lambda_\ell)
- \norm{P_0u_\ell}^2.
-\end{aligned}
-\end{equation}
-All coefficients and all squared norms on the right are nonnegative.
-For the edge $(i,j)$ in
-\cref{prop:sos-complete-graph}, take
-$P_0$ to be the projection onto
-$\operatorname{span}\{\overline e_i,\overline e_j\}$.
-\end{lemma}
-
-\begin{proof}
-Split the left-hand side as
-\begin{align*}
-    \frac12\norm K_2^2-\Tr(P_0K^*K)
-    ={}&
-    \left(\frac12\norm K_2^2-\lambda_1-\lambda_2\right)\\
-    &+\left(\lambda_1+\lambda_2-\Tr(P_0K^*K)\right).
-\end{align*}
-For the second term, put
-$p_\ell=\norm{P_0u_\ell}^2$.  Since
-$\sum_\ell p_\ell=\Tr P_0=2$, direct rearrangement gives
-\[
-\begin{aligned}
-    \lambda_1+\lambda_2-\sum_\ell\lambda_\ell p_\ell
-    ={}&
-    (\lambda_1-\lambda_2)(1-p_1)\\
-    &+\sum_{\ell\ge3}
-      (\lambda_2-\lambda_\ell)p_\ell,
-\end{aligned}
-\]
-which is the last two lines of
-\cref{eq:sos-double-skew-edge}.
-
-It remains to expand the intrinsic double-skew deficit.  Since
-$a^2+b^2=1$, the partial-swap calculation gives
-\[
-\begin{aligned}
-    \ip{z}{F_Uz}
-    ={}&
-    \norm{aXX^*-bYY^*}_2^2\\
-    &+ab\norm{X^*Y+Y^*X}_2^2.
-\end{aligned}
-\]
-The vector $z$ is fixed by the total swap, so
-\[
-    \frac12-p
-    =
-    \frac12\norm{aXX^*-bYY^*}_2^2
-    +\frac{ab}{2}\norm{X^*Y+Y^*X}_2^2.
-\]
-Because $K$ lies in the range of $P_{--}$ and the Takagi choice gives
-\[
-    \sqrt{\lambda_1+\lambda_2}
-    =\abs{\ip{K}{Jz}},
-\]
-one has
-\[
-    \lambda_1+\lambda_2
-    =p\abs{\ip{K}{\widehat K}}^2.
-\]
-Therefore
-\[
-\begin{aligned}
-    \frac12\norm K_2^2-\lambda_1-\lambda_2
-    ={}&
-    \norm K_2^2\left(\frac12-p\right)\\
-    &+p\left(
-      \norm K_2^2-\abs{\ip{K}{\widehat K}}^2
-    \right),
-\end{aligned}
-\]
-and the final parenthesis is
-$\norm{(I-\ketbra{\widehat K}{\widehat K})K}_2^2$.
-Substitution proves the formula.
-\end{proof}
-
-\begin{corollary}[Pointwise Gram/SOS certificate for the sharp score]
-\label[corollary]{cor:sos-pointwise-certificate}
-For each fixed range isometry $E$, let
-\[
-    B_E=\sum_\ell\beta_\ell\ketbra{b_\ell}{b_\ell}
-\]
-be a spectral decomposition, with $\beta_\ell\ge0$.  If
-$t^{(+)}_a$ are the columns of $\mathcal T_+$, then
-\begin{equation}
-\label{eq:sos-pointwise-main}
-    \mathsf G_r(C)
-    =
-    \sum_a\abs{\ip{t^{(+)}_a}{\delta}}^2
-    +\sum_\ell
-      \beta_\ell\abs{\ip{b_\ell}{\delta}}^2.
-\end{equation}
-Combining this with
-\cref{prop:sos-affine-score,prop:sos-trace-rank} gives a complete
-sum-of-squared-norms certificate for the exact two-copy score bound
-at every fixed Stiefel point $E$.  The positivity of the second Gram
-block is itself certified by
-\cref{prop:sos-complete-graph,lem:sos-double-skew-edge}.
-\end{corollary}
-
-\begin{proof}
-Apply the spectral decomposition of $B_E$ to
-\cref{eq:sos-main-gram}; the first summand is already the squared norm
-of $\mathcal T_+^*\delta$.  The remaining statement follows from the
-nonnegative affine combination in \cref{eq:sos-affine-score}.
-\end{proof}
-
-\begin{remark}[Relation to polynomial SOS hierarchies]
-The certificate above is an \emph{extended spectral SOS}: after the
-range isometry and the auxiliary spectral/Takagi data are fixed, it is
-an ordinary sum of squares of linear forms in the test vector
-$\delta$.  Introducing variables for the spectral data and for square
-roots of the nonnegative eigenvalue differences converts every
-weighted term into a polynomial square subject to polynomial spectral
-constraints.
-
-What has not been proved is a uniform bounded-degree SOS identity in
-the raw entries of the Stiefel variables $E$ and the coefficient
-variables $D$, with no spectral auxiliaries.  Eliminating those
-auxiliaries may increase degree or may fail at fixed degree because
-the Gram rank jumps on the equality strata.  For direct SDP use, the
-positive-map cut in \cref{cor:positive-map-cut} remains the cleaner
-linear matrix constraint; the present certificate explains
-algebraically why the underlying scalar cut is valid.
-\end{remark}
