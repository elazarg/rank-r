# Python
venv/
__pycache__/
*.pyc

# LaTeX build artifacts.  Unanchored: the manuscript lives in paper/.  The
# earlier root-anchoring existed only to protect the Z3 run logs, which are now
# under quitting-game/runs/ and ignored on their own line below.
*.aux
*.log
*.out
*.pdf
*.synctex.gz
*.fls
*.fdb_latexmk
*.toc
*.bbl
*.blg

# Saved web pages and manuscript-draft diffs: local scratch, not project content
Physics.html
*.patch

# Working notes and the numerical pre-flight harness: process, not result
ephemeral/

# Lean / Lake
/.lake/
# lake-manifest.json is deliberately NOT ignored: it pins the exact Mathlib
# revision, which is what makes the build reproducible.
